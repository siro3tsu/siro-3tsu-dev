---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import avatarImg from '../images/avatar.png';
import KeepAndroidOpen from '../components/KeepAndroidOpen.astro';

const socialLinks: { name: string; userId: string; url?: string; iconClass: string }[] = [
  { name: 'GitHub', userId: 'siro3tsu', url: 'https://github.com/siro3tsu/', iconClass: 'icon-[simple-icons--github]' },
  { name: 'X', userId: '@siro3tsu', url: 'https://x.com/siro3tsu/', iconClass: 'icon-[simple-icons--x]' },
  {
    name: 'Bluesky',
    userId: '@siro.3tsu.dev',
    url: 'https://bsky.app/profile/siro.3tsu.dev/',
    iconClass: 'icon-[simple-icons--bluesky]',
  },
  {
    name: 'Discord',
    userId: 'siro3tsu',
    iconClass: 'icon-[simple-icons--discord]',
  },
  {
    name: 'Signal',
    userId: '@siro.32',
    iconClass: 'icon-[simple-icons--signal]',
  },
  {
    name: 'Session',
    userId: '05fa5d055317428f1809a00c96236efd8be3ecbbab7d726a933e1e05e8e0f7ec64',
    iconClass: 'icon-[simple-icons--session]',
  },
  { name: 'Email', userId: '/email', url: '/email', iconClass: 'icon-[material-symbols--mail-rounded]' },
];
---

<Layout>
  <div class="flex flex-col md:flex-row gap-5">
    <div class="flex flex-col gap-4 md:w-64">
      <div class="flex flex-row md:flex-col gap-4">
        <Image
          src={avatarImg}
          alt="しろみつのアバター"
          width={208}
          height={208}
          class="rounded-full w-32 h-auto md:w-52 md:h-auto block"
        />
        <div class="flex flex-col gap-2">
          <h1 class="text-3xl font-bold">しろみつ</h1>
          <code>@siro3tsu</code>
        </div>
      </div>
      <ul class="flex flex-col gap-2">
        {
          socialLinks.map((link) => (
            <li class="flex flex-row gap-4 items-center">
              <span class="w-20 inline-flex flex-row items-center gap-1">
                <span class={`${link.iconClass} text-xl`} />
                {link.name}
              </span>
              {link.url ? (
                /https?:\/\//.test(link.url) ? (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-purple-200 dark:bg-indigo-900 px-2 py-1 rounded-full"
                  >
                    {link.userId}
                  </a>
                ) : (
                  <a href={link.url} class="bg-purple-200 dark:bg-indigo-900 px-2 py-1 rounded-full">
                    {link.userId}
                  </a>
                )
              ) : (
                <span
                  class="bg-purple-200 dark:bg-indigo-900 px-2 py-1 rounded-full max-w-38 overflow-hidden text-ellipsis cursor-pointer"
                  data-copy={link.userId}
                >
                  {link.userId}
                </span>
              )}
            </li>
          ))
        }
      </ul>
      <div
        class="copy-notification fixed opacity-0 transition-opacity bg-green-500/20 backdrop-blur-lg text-gray-900 dark:text-gray-100 border border-green-700 dark:border-green-300 rounded-md shadow-lg p-1 z-10 flex flex-row items-center gap-2"
      >
        <span class="icon-[material-symbols--check-circle-outline]"></span>コピーしました
      </div>
      <script is:inline>
        document.addEventListener('astro:page-load', () => {
          document.querySelectorAll('[data-copy]').forEach((el) => {
            el.addEventListener('click', (e) => {
              const textToCopy = el.getAttribute('data-copy');
              if (textToCopy) {
                navigator.clipboard.writeText(textToCopy).then(() => {
                  const copyNotification = document.querySelector('.copy-notification');
                  copyNotification.style.left = `${e.clientX}px`;
                  copyNotification.style.top = `${e.clientY}px`;
                  copyNotification.classList.remove('opacity-0');
                  setTimeout(() => {
                    copyNotification.classList.add('opacity-0');
                  }, 2000);
                });
              }
            });
          });
        });
      </script>
    </div>
    <div class="md:flex-1">
      <KeepAndroidOpen />
      <p>Webプログラミングが趣味の日本の高校生です。</p>
      <p>現在はフロントエンドが得意ですが、バックエンドも習得していきたいです。</p>
      <p>モットーは「無いものは自分でつくる」です。</p>
      <h2>Trivia</h2>
      <ul class="list-disc list-inside">
        <li>他の趣味：一次創作イラストの鑑賞、ボーカロイド曲やフリーBGMを聞くこと、ゲーム</li>
        <li>遊んでいるゲーム：TerraTech、Cities: Skylines</li>
        <li>好きなOS：Windows、Linux、Android</li>
      </ul>
      <h2>お問い合わせについて</h2>
      <p>ご連絡はXやBluesky、Discord、Signal、Session、メールからどうぞ。</p>
      <p>ご連絡の際は件名、お名前（ハンドルネーム可）、メッセージを記載してください。</p>
      <p class="font-bold text-red-500">
        なお、営業やスパムは固くお断りします！！！これらの送受信のたびに地球温暖化が進行してしまいます！！！
      </p>
      <h3>安全な連絡手段をご希望の場合</h3>
      <p>
        SignalやSession、メール(Tuta Mailでホスティングしています)をご利用ください。<br
        />これらの連絡手段はエンドツーエンド暗号化されており第三者による傍受や改ざんが困難です。
      </p>
    </div>
  </div>
</Layout>
<style>
  @reference 'tailwindcss';
  @custom-variant dark (&:where([data-theme=dark], [data-theme=dark] *));
  h2 {
    @apply my-2 text-2xl font-semibold pl-2 pb-1 border-b border-gray-900 dark:border-gray-100;
  }
  h3 {
    @apply text-xl font-medium pl-2 my-2;
  }
  p {
    @apply my-1 leading-relaxed;
  }
</style>
