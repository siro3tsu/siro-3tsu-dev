---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import avatarImg from '../images/avatar.png';

const socialLinks: { name: string; userId: string; url?: string; iconClass: string }[] = [
  { name: 'GitHub', userId: 'siro3tsu', url: 'https://github.com/siro3tsu/', iconClass: 'icon-[simple-icons--github]' },
  { name: 'X', userId: '@siro3tsu', url: 'https://x.com/siro3tsu/', iconClass: 'icon-[simple-icons--x]' },
  {
    name: 'Bluesky',
    userId: '@siro.3tsu.dev',
    url: 'https://bsky.app/profile/siro.3tsu.dev/',
    iconClass: 'icon-[simple-icons--bluesky]',
  },
  {
    name: 'Discord',
    userId: '@siro3tsu',
    iconClass: 'icon-[simple-icons--discord]',
  },
  {
    name: 'Signal',
    userId: '@siro.32',
    iconClass: 'icon-[simple-icons--signal]',
  },
  { name: 'Email', userId: '/email', url: '/email', iconClass: 'icon-[material-symbols--mail-rounded]' },
];
---

<Layout>
  <div class="flex flex-col md:flex-row gap-5">
    <div class="flex flex-col gap-4 md:w-64">
      <div class="flex flex-row md:flex-col gap-4">
        <Image
          src={avatarImg}
          alt="しろみつのアバター"
          width={208}
          height={208}
          class="rounded-full w-32 h-auto md:w-52 md:h-auto block"
        />
        <div class="flex flex-col gap-2">
          <h1 class="text-3xl font-bold">しろみつ</h1>
          <code>@siro3tsu</code>
        </div>
      </div>
      <ul class="flex flex-col gap-2">
        {
          socialLinks.map((link) => (
            <li class="flex flex-row gap-4 items-center">
              <span class="w-20 inline-flex flex-row items-center gap-1">
                <span class={`${link.iconClass} text-xl`} />
                {link.name}
              </span>
              {link.url ? (
                /https?:\/\//.test(link.url) ? (
                  <a
                    href={link.url}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="bg-purple-200 dark:bg-indigo-900 px-2 py-1 rounded-full"
                  >
                    {link.userId}
                  </a>
                ) : (
                  <a href={link.url} class="bg-purple-200 dark:bg-indigo-900 px-2 py-1 rounded-full">
                    {link.userId}
                  </a>
                )
              ) : (
                <span class="bg-purple-200 dark:bg-indigo-900 px-2 py-1 rounded-full select-all">{link.userId}</span>
              )}
            </li>
          ))
        }
      </ul>
    </div>
    <div class="md:flex-1">
      <p>Webプログラミングが趣味の日本の高校生です。</p>
      <p>現在はフロントエンドが得意ですが、バックエンドも習得していきたいです。</p>
      <p>モットーは「無いものは自分でつくる」です。</p>
      <h2 class="my-2 text-xl font-semibold pl-2 pb-1 border-b border-gray-900 dark:border-gray-100">Trivia</h2>
      <ul class="list-disc list-inside">
        <li>他の趣味：一次創作イラストの鑑賞、ボーカロイド曲やフリーBGMを聞くこと、ゲーム</li>
        <li>遊んでいるゲーム：TerraTech、Cities: Skylines</li>
        <li>好きな色：白、紫</li>
      </ul>
      <h2 class="my-2 text-xl font-semibold pl-2 pb-1 border-b border-gray-900 dark:border-gray-100">
        お問い合わせについて
      </h2>
      <p>ご連絡はXやBluesky、Discord、Signal、メールからどうぞ。</p>
      <p>ご連絡の際は件名、お名前（ハンドルネーム可）、メッセージを記載してください。</p>
    </div>
  </div>
</Layout>
<style>
  @reference 'tailwindcss';
  p {
    @apply my-1;
  }
</style>
