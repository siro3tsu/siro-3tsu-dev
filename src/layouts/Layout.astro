---
type Props = {
  title?: string;
  useDefaultTitle?: boolean;
};
import { ClientRouter } from 'astro:transitions';
import { siteConfig } from '../config';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import '../styles/global.css';

const { title, useDefaultTitle = title !== undefined } = Astro.props;
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/png" href="/favicon-96x96.png" sizes="96x96" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="shortcut icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <meta name="apple-mobile-web-app-title" content="Shiromitsu's Website" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="viewport" content="width=device-width" />
    <title>{title === undefined ? siteConfig.siteName : `${title} | ${siteConfig.siteName}`}</title>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <ClientRouter />
  </head>
  <body>
    <Header />
    <main class="max-w-4xl w-dvw mx-auto px-4 xl:px-0">
      {
        useDefaultTitle && (
          <h1 class="mb-2 text-3xl font-bold pl-2 pb-1 border-b-2 border-gray-900 dark:border-gray-100">{title}</h1>
        )
      }
      <slot />
    </main>
    <Footer />
  </body>
</html>
