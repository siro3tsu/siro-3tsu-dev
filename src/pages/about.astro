---
import Layout from '@layouts/Layout.astro';

const stacks: { category: string; items: { name: string; iconClass: string }[] }[] = [
  {
    category: 'Frontend',
    items: [
      { name: 'HTML', iconClass: 'icon-[simple-icons--html5]' },
      { name: 'CSS', iconClass: 'icon-[simple-icons--css]' },
      { name: 'JavaScript', iconClass: 'icon-[simple-icons--javascript]' },
      { name: 'TypeScript', iconClass: 'icon-[simple-icons--typescript]' },
      { name: 'Astro.js', iconClass: 'icon-[simple-icons--astro]' },
      { name: 'TailwindCSS', iconClass: 'icon-[simple-icons--tailwindcss]' },
    ],
  },
  {
    category: 'Serverless',
    items: [{ name: 'Cloudflare Workers', iconClass: 'icon-[simple-icons--cloudflareworkers]' }],
  },
  {
    category: 'Cloud Services',
    items: [{ name: 'Cloudflare', iconClass: 'icon-[simple-icons--cloudflare]' }],
  },
  {
    category: 'Source Management',
    items: [
      { name: 'Git', iconClass: 'icon-[simple-icons--git]' },
      { name: 'GitHub', iconClass: 'icon-[simple-icons--github]' },
    ],
  },
];
const langsColor: { [key: string]: string } = {
  'Astro.js': '#ff5a03',
};
const projects: {
  name: string;
  description: string;
  url: string;
  sourceUrl: string;
  mainLang: string;
}[] = [
  {
    name: 'siro-3tsu-dev',
    description: 'This website',
    mainLang: 'Astro.js',
    url: 'https://siro.3tsu.dev/',
    sourceUrl: 'https://github.com/siro3tsu/siro-3tsu-dev/',
  },
  {
    name: 'blog-siro-3tsu-dev',
    description: 'My blog website',
    mainLang: 'Astro.js',
    url: 'https://blog.siro.3tsu.dev/',
    sourceUrl: 'https://github.com/siro3tsu/blog-siro-3tsu-dev/',
  },
];
---

<Layout title="About me" description="しろみつの技術スタックやプロジェクトの紹介ページです。">
  <div>
    <h2>Tech Stacks</h2>
    <ul>
      {
        stacks.map((stack) => (
          <li>
            <h3>{stack.category}</h3>
            <ul class="flex flex-row gap-4 flex-wrap">
              {stack.items.map((item) => (
                <li class="flex flex-row items-center gap-1">
                  <span class={`${item.iconClass} text-2xl`} />
                  {item.name}
                </li>
              ))}
            </ul>
          </li>
        ))
      }
    </ul>
  </div>
  <div>
    <h2>Projects</h2>
    <ul class="grid grid-cols-1 sm:grid-cols-2 gap-2">
      {
        projects.map((project) => (
          <li class="border rounded-sm border-gray-900 dark:border-gray-100 p-4">
            <h3 class="text-xl font-medium p-0! m-0!">{project.name}</h3>
            <p class="text-gray-600 dark:text-gray-400">{project.description}</p>
            <p class="text-sm mt-1">
              <span
                class="inline-block w-3 h-3 rounded-full mr-1"
                style={`background-color: ${langsColor[project.mainLang]};`}
              />
              {project.mainLang}
            </p>
            <div class="flex gap-4 mt-2">
              <a
                href={project.url}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-500 dark:text-blue-300 hover:underline flex flex-row items-center gap-1"
              >
                <span class="icon-[mdi--open-in-new]" />
                Visit
              </a>
              <a
                href={project.sourceUrl}
                target="_blank"
                rel="noopener noreferrer"
                class="text-blue-500 dark:text-blue-300 hover:underline flex flex-row items-center gap-1"
              >
                <span class="icon-[mdi--code]" />
                Source Code
              </a>
            </div>
          </li>
        ))
      }
    </ul>
  </div>
</Layout>
