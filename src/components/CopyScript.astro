---

<div
  class="text-nowrap copy-notification absolute opacity-0 transition-opacity bg-green-500/20 backdrop-blur-lg text-gray-900 dark:text-gray-100 border border-green-700 dark:border-green-300 rounded-md shadow-lg p-1 z-10 flex flex-row items-center gap-2 pointer-events-none"
>
  <span class="icon-[material-symbols--check-circle-outline]"></span>コピーしました
</div>
<script is:inline>
  document.addEventListener('astro:page-load', () => {
    document.querySelectorAll('[data-copy]').forEach((el) => {
      el.addEventListener('click', (e) => {
        const textToCopy = el.getAttribute('data-copy');
        if (textToCopy) {
          navigator.clipboard.writeText(textToCopy).then(() => {
            const copyNotification = document.querySelector('.copy-notification');
            // はみ出さないようにする
            if (e.pageX + copyNotification.offsetWidth > window.innerWidth) {
              copyNotification.style.left = `${window.innerWidth - copyNotification.offsetWidth - 10}px`;
            } else {
              copyNotification.style.left = `${e.pageX}px`;
            }
            if (e.pageY + copyNotification.offsetHeight > window.innerHeight) {
              copyNotification.style.top = `${window.innerHeight - copyNotification.offsetHeight - 10}px`;
            } else {
              copyNotification.style.top = `${e.pageY}px`;
            }
            copyNotification.classList.remove('opacity-0');
            setTimeout(() => {
              copyNotification.classList.add('opacity-0');
            }, 2000);
          });
        }
      });
    });
  });
</script>
